generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin {
  id       Int     @id @default(autoincrement())
  email    String? @unique
  password String?
}

model contact_messages {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  organization String
  phone        String?
  inquiry_type String?
  subject      String?
  message      String?
  is_read      Boolean  @default(false)
  created_at   DateTime @default(now())
}

model contact_settings {
  id            Int     @id @default(autoincrement())
  heading       String?
  email         String?
  phone         String?
  location      String?
  image_url     String?
  image_caption String?
}

model inquiry_types {
  id         Int    @id @default(autoincrement())
  label      String
  value      String @unique
  sort_order Int    @default(0)
}

model hero_section {
  id              Int     @id @default(autoincrement())
  name            String?
  title           String?
  subtitle        String?
  description     String?
  cta_1_label     String?
  cta_1_path      String?
  cta_2_label     String?
  cta_2_path      String?
  backgroundImage String?
}

model identity_items {
  id          Int     @id @default(autoincrement())
  label       String?
  title       String
  description String?
  icon        String?
  image_url   String?
  sort_order  Int     @default(0)
  is_active   Boolean @default(true)
}

model navigation_items {
  id         Int     @id @default(autoincrement())
  parent_id  Int?
  label      String
  path       String?
  target     String  @default("_self")
  sort_order Int     @default(0)
  is_active  Boolean @default(true)
}

model timeline_events {
  id          Int     @id @default(autoincrement())
  slug        String? @unique
  year        String?
  title       String
  subtitle    String?
  description String?
  category    String  @default("milestone")
  icon        String?
  sort_order  Int     @default(0)
  is_active   Boolean @default(true)
}
model cms_sections {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  section_type String   @default("generic")
  eyebrow      String?
  title        String?
  subtitle     String?
  description  String?
  image_url    String?
  image_alt    String?
  metadata     Json?
  sort_order   Int      @default(0)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  blocks       cms_section_blocks[]
}

model cms_section_blocks {
  id          Int           @id @default(autoincrement())
  section_id  Int
  section     cms_sections  @relation(fields: [section_id], references: [id], onDelete: Cascade)

  block_type  String        @default("content")
  eyebrow     String?
  title       String?
  body        String?
  image_url   String?
  image_alt   String?
  metadata    Json?
  sort_order  Int           @default(0)
  is_active   Boolean       @default(true)
}